# Copy this file to ".env" and adjust. Lines starting with # are ignored.

# Public address of the site (used in sitemap.xml and canonical links)
SITE_URL=https://shuklamishra.com

# Server binding when running run_server.py directly (IIS sets the port itself)
HOST=127.0.0.1
PORT=8080

# Set to 1 once HTTPS is working: redirects http to https and marks cookies Secure
FORCE_HTTPS=0
# Set to 1 when the app runs behind IIS or another reverse proxy
BEHIND_PROXY=0

# Minutes of inactivity before the admin is signed out
ADMIN_IDLE_MINUTES=30

# Optional: where the database and uploads are stored (default: the "instance" folder)
# SMC_DATA_DIR=D:\SiteData\shuklamishra

# Optional: email notification for new queries / appointments / applications.
# Leave MAIL_SERVER empty to switch notifications off.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
