<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration (requires the HttpPlatformHandler module).
  Edit the two paths marked EDIT if the site is not in C:\inetpub\shuklamishra.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- EDIT: processPath must be the full path to python.exe inside the site's .venv -->
    <httpPlatform processPath="C:\inetpub\shuklamishra\.venv\Scripts\python.exe"
                  arguments="run_server.py"
                  startupTimeLimit="60"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\shuklamishra\logs\server">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="BEHIND_PROXY" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- 12 MB upload ceiling, matching the application -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
